# --- Database (Supabase PostgreSQL) ---
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=your-db-password
DB_DATABASE=postgres
DB_SSL=require
# Prisma connection strings (pooled + direct). Keep in sync with DB_* above.
DATABASE_URL=postgresql://postgres.<project-ref>:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth (Supabase) ---
# Project URL is https://<project-ref>.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET={"keys":[{"x":"...","y":"...","alg":"ES256","crv":"P-256","ext":true,"kid":"...","kty":"EC"}]}

# --- Legacy JWT (fallback for local/non-supabase flows) ---
JWT_SECRET=replace-with-a-long-random-string

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# --- Weather providers ---
WEATHER_PROVIDERS=openweather,weatherapi
WEATHERAPI_API_KEY=your-weatherapi-key
OPENWEATHER_API_KEY=your-openweather-key
IMD_API_KEY=your-imd-key

# --- ML service ---
ML_SERVICE_URL=http://localhost:8000
ML_API_TOKEN=share-a-token-with-the-ml-service
ML_INSECURE_DEV_MODE=false

# --- Environment ---
# `development` for local dev; ANY real deployment MUST set `production`.
# When unset, the app assumes non-production: env validation is skipped,
# Swagger stays enabled, and dev CORS origins are allowed.
NODE_ENV=development

# --- App behaviour ---
VISIBLE_DATA_TTL_DAYS=1
# Public origin of the web app. Used to build links sent in emails
# (e.g. password reset redirectTo). Production: https://mausamnet-ai.vercel.app
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Disable the public /api/docs Swagger UI in production. Set to true to force-enable.
SWAGGER_ENABLED=false

# --- Frontend runtime ---
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Weather sync (districts + major cities) ---
# Runs every WEATHER_SYNC_INTERVAL_MINUTES against the location registry
# (763 districts + 306 major cities). Disable with WEATHER_SYNC_ENABLED=false.
WEATHER_SYNC_ENABLED=true
WEATHER_SYNC_INTERVAL_MINUTES=60
WEATHER_SYNC_CONCURRENCY=5
# A queued/running run stays "active" for at most this long before being
# auto-failed as stale — protects against a crashed/stuck worker blocking
# every future sync (must exceed how long a full 1069-location run takes).
WEATHER_SYNC_RUN_TIMEOUT_MINUTES=120
# Per-location jobs are individually timed out so one hung fetch/DB call
# cannot freeze the whole Kafka consumer on a partition.
WEATHER_SYNC_JOB_TIMEOUT_MS=60000

# --- Broker (optional) ---
WEBSOCKET_ENABLED=true
# When KAFKA_ENABLED=true, sync jobs and snapshots flow through Kafka:
#   mausamnet.weather.sync     -> jobs consumed by the API worker
#   mausamnet.weather.snapshot -> snapshots consumed by the PySpark service
# When disabled, jobs run in-process and sync still works.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=mausamnet-api
KAFKA_TOPIC_AUTOCREATE=true
KAFKA_TOPIC_WEATHER_SYNC=mausamnet.weather.sync
KAFKA_TOPIC_WEATHER_SNAPSHOT=mausamnet.weather.snapshot

# --- PySpark analytics service (services/spark) ---
SPARK_ENABLED=false
SPARK_OUTPUT_DIR=services/spark/data/analytics
SPARK_SUMMARY_DIR=services/spark/data/output/summaries

# --- Report ingestion (auto-generates reports from weather snapshots) ---
# When INGESTION_ENABLED=true, non-benign weather conditions are automatically
# turned into reports during each weather sync run. Disable with false to stop.
INGESTION_ENABLED=true

# --- Admin bootstrap (used by prisma:seed) ---
ADMIN_EMAIL=admin@example.com