{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@nestjs/typeorm$": "<rootDir>/__mocks__/nestjs-typeorm.js",
    "^@nestjs/config$": "<rootDir>/__mocks__/nestjs-config.js"
  }
}
